# JobAppTracker Mobile App Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Environment
# ===========================================
# Options: development, preview, production
EXPO_PUBLIC_APP_ENV=development

# ===========================================
# API Configuration
# ===========================================
# Override the default API URL for your environment
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ===========================================
# Google OAuth Configuration
# ===========================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 credentials for iOS, Android, and Web

# Development client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID_DEV=your-dev-google-client-id.apps.googleusercontent.com

# Preview/Staging client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID_PREVIEW=your-preview-google-client-id.apps.googleusercontent.com

# Production client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-prod-google-client-id.apps.googleusercontent.com

# Platform-specific client IDs (optional, falls back to main client ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-google-client-id.apps.googleusercontent.com

# ===========================================
# EAS Build Configuration (for CI/CD)
# ===========================================
# These are typically set in EAS secrets, not in .env files
# APPLE_ID=your-apple-id@example.com
# ASC_APP_ID=your-app-store-connect-app-id
# APPLE_TEAM_ID=your-apple-team-id
