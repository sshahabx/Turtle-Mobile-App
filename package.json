    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "react-native-worklets-core": "^1.6.2",
    "react-test-renderer": "^18.3.1",
