    "expo-haptics": "~14.0.1",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "nativewind": "^2.0.11",
    "react": "18.3.1",
    "react-native": "0.76.5",
